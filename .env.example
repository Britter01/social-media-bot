# =====================================================================
# Brite Tech Lifestyle — social media automation
# Copy to `.env` and fill in. NEVER commit the real .env (see .gitignore).
# =====================================================================

# --- Brand identity ---------------------------------------------------
BRAND_NAME="Brite Tech Lifestyle"
BRAND_FOUNDER="Dean Britter"
BRAND_TAGLINE="Technology, beautifully lived."

# --- Runtime behaviour ------------------------------------------------
# DRY_RUN=true logs what would be posted without calling external APIs.
DRY_RUN=true
LOG_LEVEL=INFO
TIMEZONE=Europe/London
# How many posts to create per content-pipeline run.
POSTS_PER_RUN=1

# --- Research agent ---------------------------------------------------
# Minimum brand-relevance score (0-100) a trending topic must reach to be
# turned into a post. Lower-scoring topics are stored but not used.
MIN_TOPIC_RELEVANCE=70
# How many of the top-scoring topics to surface per research run.
TOPICS_PER_RUN=3
# When true (default), researched topics wait for human approval before
# they become posts — review them with `python -m scripts.review_topics`.
# Set false to let the research agent post automatically (no gate).
REQUIRE_TOPIC_APPROVAL=true

# --- Anthropic (text generation) --------------------------------------
ANTHROPIC_API_KEY=
# Two cost tiers (no Opus). Creative = captions, ideation, topic scoring;
# Fast = simple/repetitive work (e.g. trend discovery). See each agent's
# module docstring for why it picked its tier.
ANTHROPIC_MODEL_CREATIVE=claude-sonnet-4-6
ANTHROPIC_MODEL_FAST=claude-haiku-4-5

# --- Higgsfield Soul (image generation — primary when key is set) ------
HIGGSFIELD_API_KEY=

# --- Google Imagen 4 Fast (thumbnails — fallback when Higgsfield absent) ---
GOOGLE_API_KEY=
IMAGEN_MODEL=imagen-4.0-fast-generate-001

# --- HeyGen (video with cloned voice) ---------------------------------
HEYGEN_API_KEY=
HEYGEN_VOICE_ID=
HEYGEN_AVATAR_ID=

# --- Supabase (database + storage) ------------------------------------
SUPABASE_URL=
SUPABASE_KEY=
# Public Storage bucket for generated media (thumbnails, etc.)
SUPABASE_BUCKET=media

# --- Instagram (Graph API) --------------------------------------------
INSTAGRAM_ACCESS_TOKEN=
INSTAGRAM_BUSINESS_ACCOUNT_ID=

# --- X / Twitter (API v2, OAuth 1.0a) ---------------------------------
TWITTER_API_KEY=
TWITTER_API_SECRET=
TWITTER_ACCESS_TOKEN=
TWITTER_ACCESS_SECRET=

# --- LinkedIn (UGC Posts API) -----------------------------------------
LINKEDIN_ACCESS_TOKEN=
# e.g. urn:li:person:XXXX or urn:li:organization:XXXX
LINKEDIN_AUTHOR_URN=
# Company page to cross-post to (Brite Tech Lifestyle), e.g.
# urn:li:organization:12345678. Leave blank to auto-discover from the pages the
# token's member administers. Requires the w_organization_social scope, which
# LinkedIn grants only to apps approved for the Community Management API —
# without it the page post is skipped and the personal post still goes out.
LINKEDIN_ORG_URN=
# Where LinkedIn posts go: both (default) | personal | organization
LINKEDIN_POST_TARGETS=both
# When the page can't be posted to via the API (the usual case — see the scope
# note above), send the post to Telegram so it can be posted to the page by
# hand, exactly like Instagram. Set to false to skip the page entirely.
LINKEDIN_PAGE_TELEGRAM_FALLBACK=true

# --- YouTube (Data API v3) --------------------------------------------
YOUTUBE_CLIENT_ID=
YOUTUBE_CLIENT_SECRET=
YOUTUBE_REFRESH_TOKEN=

# --- TikTok (Content Posting API) -------------------------------------
TIKTOK_ACCESS_TOKEN=
